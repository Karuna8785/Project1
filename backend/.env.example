# SmartERP Backend Environment Variables
PROJECT_NAME="SmartERP"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security / JWT Authentication
SECRET_KEY="smarterp-production-random-secret-key-change-this-value-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (works with 0 setup out of the box):
DATABASE_URL="sqlite:///./smarterp.db"
# PostgreSQL Configuration (uncomment and replace when PostgreSQL service is active):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smarterp"
SQLITE_FALLBACK_URL="sqlite:///./smarterp.db"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Initial Admin Credentials (for seed script)
DEFAULT_ADMIN_PASSWORD="Admin@ChangeMe123"

# Modules Enabled
HR_MODULE_ENABLED=True
SALES_MODULE_ENABLED=True
INVENTORY_MODULE_ENABLED=True
