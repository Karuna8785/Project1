# Backend Environment Variables Template
PROJECT_NAME="SmartERP"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smarterp"
SQLITE_FALLBACK_URL="sqlite:///./smarterp.db"

# Security / JWT Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (for seed script)
DEFAULT_ADMIN_PASSWORD="Admin@ChangeMe123"
