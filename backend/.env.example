# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smarterp

# JWT (Member 1 - Auth Module)
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=SmartERP
APP_VERSION=1.0.0
DEBUG=True

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# HR Module
HR_MODULE_ENABLED=True
